# Copy these NAMES into your host's environment-variable settings.
# Never commit a real key to git, and never put it in the web page.
GEMINI_API_KEY=your-google-ai-studio-key
ADMIN_TOKEN=any-long-random-string-you-choose
GEMINI_MODEL=gemini-3.5-flash
DAILY_GRADE_CAP=200
# PORT is set automatically by Render/Railway.
